# Copie este arquivo para .env.local (que fica fora do git) e preencha com os valores
# do seu projeto Firebase: console.firebase.google.com > Configurações do projeto >
# "Seus apps" > app Web > bloco "firebaseConfig".
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Domínio de e-mail que pode entrar no app (ex: dduck.com.br). Isso é só um atalho de
# interface para o Google já filtrar contas — quem realmente trava o acesso são as regras
# de segurança do Firestore (firestore.rules).
VITE_ALLOWED_EMAIL_DOMAIN=
