rules_version = '2';

// Cole este arquivo em: Firebase Console > Build > Firestore Database > Regras.
//
// Só contas @dduck.com.br com e-mail verificado pelo Google conseguem ler ou escrever
// qualquer coisa neste banco — é essa regra, não o app em si, que realmente protege os dados.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@dduck[.]com[.]br$');
    }

    match /{document=**} {
      allow read, write: if isAllowed();
    }
  }
}
